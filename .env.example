# Ationic website environment configuration
# Set these in Netlify UI > Site settings > Environment variables.
# Never commit real secrets to this repository.

# REQUIRED for the blog (public WordPress REST API — no credentials needed):
#   The /posts, /categories etc. endpoints are appended automatically.
WORDPRESS_API_URL=https://public-api.wordpress.com/wp/v2/sites/ationicagency.wordpress.com

# OPTIONAL: absolute base URL used for canonical/OG/sitemap URLs.
# Defaults to https://ationic.agency when unset.
SITE_URL=https://ationic.agency

# OPTIONAL: timeout in milliseconds for WordPress API calls. Default 20000.
# WORDPRESS_TIMEOUT_MS=20000
