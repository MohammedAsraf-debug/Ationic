# Ationic website environment configuration
# Copy the values into Netlify UI > Site settings > Environment variables.
# Never commit real secrets to this repository.

# REQUIRED for the blog (public WordPress REST API endpoint, no credentials):
#   Example: https://cms.example.com/wp-json/wp/v2
# Until this is set, /blog/ shows a clean "being prepared" placeholder.
WORDPRESS_API_URL=

# OPTIONAL: absolute base URL used for canonical/OG/sitemap URLs.
# Defaults to https://ationic.agency when unset.
SITE_URL=https://ationic.agency

# OPTIONAL: timeout in milliseconds for WordPress API calls. Default 6000.
# WORDPRESS_TIMEOUT_MS=6000
